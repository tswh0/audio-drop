{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "pinDigests": true,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchFileNames": ["docker-compose.yml"],
      "pinDigests": false
    },
    {
      "matchPackageNames": ["yt-dlp"],
      "prPriority": 10
    }
  ]
}
